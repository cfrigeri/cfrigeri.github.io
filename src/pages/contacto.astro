---
import Base from '../layouts/Base.astro';
import FormContacto from '../components/FormContacto.astro';
import { SITIO } from '../config/sitio';
---

<Base titulo="Escribime" descripcion="En qué andás: un sistema que no escala, una integración pendiente o una idea con IA.">
  <section class="cabecera">
    <div class="marco">
      <h1>Contame en qué andás.</h1>
      <p>
        Un sistema que no escala, una integración pendiente, una idea con IA que no sabés por dónde empezar o un tema para un
        próximo artículo.
      </p>
    </div>
  </section>
  <section class="seccion pt-5">
    <div class="marco dos-columnas">
      <FormContacto />
      <div>
        <h2 class="h4">Si preferís otro canal</h2>
        <ul class="list-unstyled fs-5 mt-3 d-grid gap-2">
          <li><a class="enlace" href={SITIO.enlaces.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a class="enlace" href={SITIO.enlaces.github} rel="me noopener" target="_blank">GitHub</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
