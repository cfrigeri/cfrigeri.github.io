---
import { render } from 'astro:content';
import Articulo from '../../layouts/Articulo.astro';
import { obtenerPublicados, type Articulo as TArticulo } from '../../lib/articulos';

export async function getStaticPaths() {
  const publicados = await obtenerPublicados();
  return publicados.map((articulo) => ({ params: { slug: articulo.id }, props: { articulo } }));
}

const { articulo } = Astro.props as { articulo: TArticulo };
const { Content } = await render(articulo);
---

<Articulo articulo={articulo}>
  <Content />
</Articulo>
