---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import DiagramaMetodo from '../components/DiagramaMetodo.astro';
import { obtenerPublicados } from '../lib/articulos';
import { formatearFecha } from '../lib/fechas';
import foto from '../assets/claudio.jpg';

const [destacado, ...otros] = (await obtenerPublicados()).slice(0, 4);

const temas = ['Integraciones y APIs', 'Agentes de IA', 'Arquitectura y legacy', 'Flujos que se traban'];

// Situaciones reales, contadas sin nombres de empresas. Cada una termina en una invitación a conversar.
const casos = [
  {
    titulo: 'Un homebanking que nadie se animaba a tocar',
    problema: 'Una plataforma crítica sobre tecnología legacy, que los clientes usan todos los días.',
    solucion: 'Migrarla completa a una arquitectura cloud, por etapas.',
    pregunta: '¿Tenés un sistema así?',
    accion: 'Contame cómo es',
  },
  {
    titulo: 'Abrir el banco a terceros sin perder el control',
    problema: 'Importantes actores del ecosistema fintech necesitaban integrarse, y cada error se mide en dinero.',
    solucion: 'APIs con contratos claros y trazabilidad, que hoy procesan millones de transacciones.',
    pregunta: '¿Estás por integrar a un socio?',
    accion: 'Pensémoslo juntos',
  },
  {
    titulo: 'Equipos que tardaban demasiado en llegar a producción',
    problema: 'Cada proyecto arrancaba de cero y la calidad dependía de quién lo hiciera.',
    solucion: 'Un framework interno de desarrollo que acortó los tiempos y ordenó el código.',
    pregunta: '¿A tu equipo le pasa algo parecido?',
    accion: 'Escribime',
  },
];

const ideas = [
  {
    titulo: 'Empezar por el cuello de botella',
    texto: 'No por la herramienta de moda. Primero entiendo dónde se traba la operación.',
  },
  { titulo: 'Conectar sin romper', texto: 'Lo que ya funciona queda como está. La IA entra por una puerta controlada.' },
  {
    titulo: 'Medir desde el día uno',
    texto: 'Si no sabés cuánto acierta y cuánto cuesta, no sabés si conviene escalarla.',
  },
];

const portadaDestacado = destacado?.data.imagen
  ? await getImage({ src: destacado.data.imagen, width: 900, format: 'webp' })
  : undefined;
---

<Base>
  <section class="hero">
    <div class="marco hero-grid">
      <div>
        <h1>Pongo la IA a trabajar en sistemas reales. Y te cuento <span class="resaltado">cómo.</span></h1>
        <p>
          Pasé <strong>13 años en banca digital</strong>, donde un error cuesta caro. Acá escribo sobre integraciones, agentes
          de IA y arquitectura: lo que funciona, lo que no y por qué.
        </p>
        <div class="acciones">
          <a class="btn" href="/articulos">Leer los artículos</a>
          <a class="enlace" href="/sobre-mi">Quién soy</a>
        </div>
      </div>
      <div class="polaroid">
        <span class="sello">Hola, soy Claudio</span>
        <figure>
          <Image
            src={foto}
            alt="Claudio Frigeri sentado frente a una ventana, con edificios de Buenos Aires de fondo"
            widths={[380, 760]}
            sizes="(max-width: 991px) 90vw, 380px"
            loading="eager"
          />
          <figcaption>En la oficina, con Buenos Aires de fondo.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="temas" aria-label="Temas">
    <div class="marco">
      <span>De lo que suelo hablar</span>
      {temas.map((t) => <b>{t}</b>)}
    </div>
  </section>

  <section class="seccion" id="casos" aria-labelledby="titulo-casos">
    <div class="marco">
      <div class="seccion-cabeza">
        <h2 id="titulo-casos">Problemas que me tocó destrabar</h2>
        <p>Tres situaciones reales, contadas sin nombres. Si alguna te suena, probablemente tengamos de qué hablar.</p>
      </div>
      <div class="casos">
        {
          casos.map((c) => (
            <article class="caso">
              <h3>{c.titulo}</h3>
              <dl>
                <dt>El problema</dt>
                <dd>{c.problema}</dd>
                <dt>Lo que hicimos</dt>
                <dd>{c.solucion}</dd>
              </dl>
              <p class="pregunta">
                {c.pregunta}{' '}
                <a class="enlace" href="/contacto">
                  {c.accion}
                </a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion oscura" id="como-pienso" aria-labelledby="titulo-como-pienso">
    <div class="marco">
      <div class="seccion-cabeza">
        <h2 id="titulo-como-pienso">Cómo pienso la IA dentro de un sistema</h2>
        <p>La IA no reemplaza lo que ya funciona. Se conecta por APIs, resuelve una parte concreta y cada resultado se mide.</p>
      </div>
      <DiagramaMetodo />
      <ul class="ideas">
        {
          ideas.map(({ titulo, texto }) => (
            <li>
              <b>{titulo}</b>
              <span>{texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion" id="escritos" aria-labelledby="titulo-escritos">
    <div class="marco">
      <div class="seccion-cabeza">
        <h2 id="titulo-escritos">Lo que voy escribiendo</h2>
        <p>Un artículo por semana, con ejemplos concretos y sin humo.</p>
      </div>
      {
        destacado ? (
          <div class="escritos">
            <article class="nota">
              {portadaDestacado && (
                <a class="nota-portada" href={`/articulos/${destacado.id}`} tabindex="-1" aria-hidden="true">
                  <img src={portadaDestacado.src} alt="" width="900" height="473" loading="lazy" />
                </a>
              )}
              <div class="nota-cuerpo">
                <time datetime={destacado.data.fecha.toISOString()}>{formatearFecha(destacado.data.fecha)}</time>
                <h3>
                  <a href={`/articulos/${destacado.id}`}>{destacado.data.titulo}</a>
                </h3>
                <p>{destacado.data.resumen}</p>
                <a class="enlace" href={`/articulos/${destacado.id}`}>
                  Leer el artículo
                </a>
              </div>
            </article>
            <div class="mas-notas">
              {otros.length > 0 ? (
                <>
                  <h3>Más artículos</h3>
                  {otros.map((articulo) => (
                    <TarjetaArticulo articulo={articulo} nivel="h3" />
                  ))}
                  <p class="mt-3">
                    <a class="enlace" href="/articulos">
                      Ver todos los artículos
                    </a>
                  </p>
                </>
              ) : (
                <>
                  <h3>¿De qué te gustaría que escriba?</h3>
                  <p class="text-body-secondary">
                    Cada semana sumo un artículo nuevo. Si hay un tema que te está dando vueltas, contámelo y lo tengo en
                    cuenta.
                  </p>
                  <a class="enlace" href="/contacto">
                    Proponer un tema
                  </a>
                </>
              )}
            </div>
          </div>
        ) : (
          <p class="fs-5">Pronto vas a encontrar acá los primeros artículos.</p>
        )
      }
    </div>
  </section>

  <section class="cierre" aria-labelledby="titulo-cierre">
    <div class="marco">
      <div class="invitacion">
        <h2 id="titulo-cierre">¿Estás peleando con algo parecido?</h2>
        <div>
          <p>
            Contame en qué andás. Puede ser un sistema que no escala, una integración pendiente o una idea con IA que no sabés
            por dónde empezar.
          </p>
          <a class="btn" href="/contacto">Escribime</a>
          <small>Leo todos los mensajes y respondo yo.</small>
        </div>
      </div>
    </div>
  </section>
</Base>
